# 이 파일을 .env.local로 복사한 뒤 값을 채우세요. (.env.local은 git에 올리지 않음)

# 로컬 PostgreSQL (docker-compose.yml 기본값)
DATABASE_URL=postgres://app:app@localhost:5432/starquest

# Gemini 무료 API 키: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 사용할 모델 (무료 등급에서 쓸 수 있는 모델인지 AI Studio에서 확인)
GEMINI_MODEL=gemini-3.8-flash

# 공공 API (data.go.kr, 온통청년)
YOUTH_POLICY_API_KEY=
YOUTH_CENTER_API_KEY=
WELFARE_API_KEY=
VOLUNTEER_1365_API_KEY=

# 카카오맵 JavaScript 키 (브라우저에서 쓰므로 NEXT_PUBLIC_)
NEXT_PUBLIC_KAKAO_MAP_KEY=
