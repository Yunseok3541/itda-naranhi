# 이 파일은 양식이다. 복사해서 .env.local을 만들고 거기에 실제 값을 채운다 (.env.local은 git에 올리지 않음)
#   Git Bash: cp .env.example .env.local   /   PowerShell: Copy-Item .env.example .env.local
# 이 파일에는 실제 주소·키·비밀번호를 절대 쓰지 않는다
# 배포(Vercel)는 이 파일을 읽지 않는다 → Vercel 프로젝트 Settings → Environment Variables에 같은 이름으로 입력
#
# 각 항목: [무엇] / [어디서 받나] / [어디서 쓰나] / [지금 필요?]
#   필요 ✅ = 지금 코드가 읽음  ·  예정 ⏳ = 아직 읽는 코드 없음 (기능을 붙일 때 사용)

# ════════════════════════════════════════════════════════════════════
#  서버 전용 (브라우저에 노출되지 않음)
# ════════════════════════════════════════════════════════════════════

# ── DB ───────────────────────────────────────────────────────────────
# [무엇] PostgreSQL 접속 주소 (아이디·비밀번호가 들어 있음)
# [어디서] 팀 공용 Neon → 팀 DM으로 받은 "Pooled connection" 주소 (호스트에 -pooler 가 들어간 것)
#          형식: postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
#          로컬 Docker(선택): postgres://app:app@localhost:5432/starquest
# [쓰는 곳] web/src/lib/db.ts (모든 API)
# [필요] ✅ 없으면 DB를 쓰는 API가 모두 실패
DATABASE_URL=

# ── AI (Gemini) ──────────────────────────────────────────────────────
# [무엇] Google Gemini API 키
# [어디서] https://aistudio.google.com/apikey (무료 등급)
# [쓰는 곳] web/src/lib/gemini.ts → 체크인 날씨·위기 표현, 별 추천, 회고 응원, 문의 초안
# [필요] ✅ 비워 두면 AI 대신 미리 정한 기본값으로 동작 (앱은 멈추지 않음)
GEMINI_API_KEY=

# [무엇] 사용할 Gemini 모델 이름 (키가 아님, 비밀 아님)
# [어디서] AI Studio에서 무료 등급으로 쓸 수 있는 모델인지 확인
# [쓰는 곳] web/src/lib/gemini.ts, /api/health 에 표시
# [필요] ✅ 비우면 코드의 기본 모델 사용
GEMINI_MODEL=gemini-3.5-flash-lite

# ── 온통청년 (youthcenter.go.kr) ─────────────────────────────────────
# 발급: 온통청년 회원가입 → 로그인 → 마이페이지 → 오픈(OPEN) API 신청 → 담당자 승인 후 발급
# 문서: https://www.youthcenter.go.kr/cmnFooter/openapiIntro/oaiDoc  (요청 시 키 파라미터 이름: openApiVlak)

# [무엇] 온통청년 "청년정책" API 인증키 (정책 목록·상세)
# [쓰는 곳] 정책 수집·AI 분류 스크립트 → policies 테이블 → 정책 추천 (AI ⑤)
# [필요] ⏳ 아직 읽는 코드 없음
YOUTH_POLICY_API_KEY=

# [무엇] 온통청년 "청년공간(청년센터)" API 인증키 (센터 이름·주소·연락처)
#        온통청년은 API마다 인증키가 따로 발급됨 (청년정책 키와 다른 값)
# [쓰는 곳] 청년센터 수집 → youth_centers 테이블 → 지도·센터 상세 (지금은 api/_lib/centers-data.ts 정적 데이터)
# [필요] ⏳ 아직 읽는 코드 없음
YOUTH_CENTER_API_KEY=

# [무엇] 온통청년 "청년콘텐츠" API 인증키 (온통청년이 올리는 청년 대상 콘텐츠·소식)
# [쓰는 곳] 아직 정해지지 않음 (활용 여부 미정)
# [필요] ⏳ 아직 읽는 코드 없음
YOUTH_CONTENT_API_KEY=

# ── 공공데이터포털 (data.go.kr) ─────────────────────────────────────
# 발급: 공공데이터포털 로그인 → 각 API "활용신청" → 마이페이지 → 일반 인증키(Decoding) 복사
#       포털 키는 계정당 1개라 1365·복지서비스를 이 키 하나로 호출한다

# [무엇] 공공데이터포털 일반 인증키 (Decoding 값)
# [쓰는 곳] 1365 봉사참여정보, 지자체 복지서비스, 중앙부처 복지서비스 수집 (세 API 모두 활용신청 승인 확인, 응답은 XML)
# [필요] ⏳ 아직 읽는 코드 없음
DATA_GO_KR_KEY=

# [무엇] 행정안전부 1365 봉사참여정보서비스 요청 주소 (키가 아님, 비밀 아님)
# [필요] ⏳ 6단계 봉사 연계 (MVP 이후)
VOLUNTEER_BASE_URL=

# [무엇] 지자체 복지서비스 API 요청 주소 (키가 아님, 비밀 아님)
# [필요] ⏳ 심리상담 바우처 등 복지서비스 수집
WELFARE_BASE_URL=

# ════════════════════════════════════════════════════════════════════
#  브라우저에서 읽는 값 (NEXT_PUBLIC_ 으로 시작하면 화면 코드에 그대로 공개됨)
# ════════════════════════════════════════════════════════════════════

# [무엇] 카카오맵 "JavaScript 키" (지도 표시용. REST API 키와 다름)
# [어디서] https://developers.kakao.com → 내 애플리케이션 → 앱 키 → JavaScript 키
#          플랫폼(Web)에 http://localhost:3000 과 Vercel 배포 주소를 등록해야 동작 (등록한 도메인에서만 쓰여서 공개돼도 안전)
# [쓰는 곳] 청년센터 지도 화면
# [필요] ⏳ 지도를 붙일 때
NEXT_PUBLIC_KAKAO_MAP_KEY=

# ── 필요 없는 것 ─────────────────────────────────────────────────────
# 데모 세션(POST /api/demo/session): 별도 비밀 값 없음 (무작위 토큰 + DB에 해시 저장)
# API 주소: 화면은 같은 앱의 API를 fetch('/api/...')로 부르므로 필요 없음
