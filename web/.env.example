# 이 파일은 양식이다. 복사해서 .env.local을 만들고 거기에 실제 값을 채운다 (.env.local은 git에 올리지 않음)
#   Git Bash: cp .env.example .env.local   /   PowerShell: Copy-Item .env.example .env.local
# 이 파일에는 실제 주소·키·비밀번호를 절대 쓰지 않는다
# 배포(Vercel)는 이 파일을 읽지 않는다 → Vercel 프로젝트 Settings → Environment Variables에 같은 이름으로 입력

# ── 서버 전용 (브라우저에 노출되지 않음) ─────────────────────────

# PostgreSQL
#   팀 공용 Neon: 팀 DM으로 받은 "Pooled connection" 주소 (호스트에 -pooler 가 들어간 주소)
#     형식: postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
#   로컬 Docker(선택): postgres://app:app@localhost:5432/starquest
DATABASE_URL=

# Gemini 무료 API 키: https://aistudio.google.com/apikey  (비워 두면 AI 기능은 기본값으로 동작)
GEMINI_API_KEY=
# 사용할 모델 (무료 등급에서 쓸 수 있는 모델인지 AI Studio에서 확인)
GEMINI_MODEL=gemini-3.5-flash

# 공공 API (data.go.kr, 온통청년)
YOUTH_POLICY_API_KEY=
YOUTH_CENTER_API_KEY=
WELFARE_API_KEY=
VOLUNTEER_1365_API_KEY=

# data.go.kr — 마이페이지 > 일반 인증키(Decoding). 1365 · 지자체복지서비스 둘 다 이 키 하나로 호출
DATA_GO_KR_KEY=
VOLUNTEER_BASE_URL=
WELFARE_BASE_URL=

# ── 브라우저에서 읽는 값 (NEXT_PUBLIC_ 은 화면에 공개됨) ─────────────

# 카카오맵 JavaScript 키 (카카오 개발자 콘솔에 등록한 도메인에서만 동작)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 참고: 데모 세션(POST /api/demo/session)은 별도 비밀 값이 필요 없다 (무작위 토큰 + DB에 해시 저장)
# 참고: 화면은 같은 앱의 API를 fetch('/api/...')로 부르므로 API 주소용 환경 변수도 필요 없다
