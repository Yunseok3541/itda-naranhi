# 이 파일을 .env.local로 복사한 뒤 값을 채우세요. (.env.local은 git에 올리지 않음)

# PostgreSQL
# 로컬 Docker(저장소 루트 docker-compose.yml) 기본값. Neon을 쓰면 Pooled 연결 주소로 교체
# 배포(Vercel)에서는 이 파일이 아니라 Vercel 환경 변수에 입력
DATABASE_URL=postgresql://neondb_owner:npg_0UNKFuTPR5gE@ep-gentle-surf-a11bvwe6-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Gemini 무료 API 키: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 사용할 모델 (무료 등급에서 쓸 수 있는 모델인지 AI Studio에서 확인)
GEMINI_MODEL=gemini-3.8-flash

# 공공 API (data.go.kr, 온통청년)
YOUTH_POLICY_API_KEY=
YOUTH_CENTER_API_KEY=
WELFARE_API_KEY=
VOLUNTEER_1365_API_KEY=

# 카카오맵 JavaScript 키 (브라우저에서 쓰므로 NEXT_PUBLIC_)
NEXT_PUBLIC_KAKAO_MAP_KEY=
